generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  seiueId       Int             @id @unique
  schoolId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accessToken   String?
  name          String
  pinyin        String
  phone         String?
  adminClass0   String?
  classTeacher0 String?
  gender        Gender
  lastUserAgent String
  admin         Boolean         @default(false)
  type          UserType
  logs          UserAuditLog[]
  appLogs       AppAuditLog[]
  accessCodes   AccessCode[]
  auths         Authorization[]
  apps          Application[]
  lastSMSVerify DateTime        @default("2022-12-07T17:24:53Z")
  lastSendSMS   DateTime        @default("2022-12-07T17:24:53Z")
  lastSMSPhone  String?
  lastSMSCode   String?
}

model AccessCode {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  code       String
  userId     Int
  user       User     @relation(fields: [userId], references: [seiueId], onDelete: Cascade)
  persistent Boolean
}

model Application {
  id           Int               @id @default(autoincrement())
  name         String
  icon         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  redirectUrls String[]
  scopes       Scope[]
  clientId     String
  clientSecret String
  owner        User              @relation(fields: [ownerId], references: [seiueId])
  ownerId      Int
  message      String
  approved     ApprovalStatus
  homepage     String
  terms        String?
  privacy      String?
  logs         AppAuditLog[]
  auths        Authorization[]
  approval     ApprovalRequest[]
  accessGated  Boolean           @default(false)
  allowedUsers Int[]
}

model Authorization {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [seiueId], onDelete: Cascade)
  userId        Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId Int
  legacyTokens Boolean @default(false)
  smsPhone      String?
  scopes        String[]
}

model ApprovalRequest {
  id            Int         @id @default(autoincrement())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId Int
}

model UserAuditLog {
  id     Int              @id @default(autoincrement())
  time   DateTime         @default(now())
  type   UserAuditLogType
  user   User             @relation(fields: [userId], references: [seiueId], onDelete: Cascade)
  userId Int
  values String[]
}

model AppAuditLog {
  id              Int             @id @default(autoincrement())
  time            DateTime        @default(now())
  type            AppAuditLogType
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   Int
  operationUser   User            @relation(fields: [operationUserId], references: [seiueId], onDelete: Cascade)
  operationUserId Int
  values          String[]
}

enum UserType {
  student
  teacher
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum UserAuditLogType {
  created // [User agent, IP address]
  logIn // [User agent, IP address]
  authorizedApp // [app id]
  deauthorizedApp // [app id]
}

enum AppAuditLogType {
  created
  updated
  authorizedUser // [scope 1, scope 2, ...]
}

enum Scope {
  basic
  phone
  calendar
  sms
}

enum Gender {
  male
  female
  others
}

model SessionRevocation {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginRateLimit {
  key       String   @id
  attempts  Int
  windowEnd DateTime

  @@index([windowEnd])
}
